# Copy to .env.local and replace every value. All values below are placeholders.

# ─── Database (Supabase Postgres) ───────────────────────────────────────────────
# Owner connection (the "postgres" user). Used only by scripts/db.mjs for migrate and seed, never by the app.
DATABASE_ADMIN_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres
# App connection as the pollen_app role (RLS enforced), through Supabase's transaction pooler on port 6543.
DATABASE_URL=postgresql://pollen_app.your-project-ref:your-pollen-app-password@your-pooler-host.pooler.supabase.com:6543/postgres
# Password that `migrate` sets on the pollen_app role; must match the password inside DATABASE_URL.
POLLEN_APP_PASSWORD=your-pollen-app-password

# ─── Secrets ───────────────────────────────────────────────────────────────────
# 32 random bytes, base64 (`openssl rand -base64 32`). Encrypts tenants' BYOK keys and signs email links.
ENCRYPTION_KEY=replace-with-output-of-openssl-rand-base64-32
# Signs NextAuth session JWTs (`openssl rand -base64 32`).
NEXTAUTH_SECRET=replace-with-a-long-random-string
# Public base URL of this app, used by NextAuth for sign-in callbacks.
NEXTAUTH_URL=http://localhost:3000

# ─── Optional ──────────────────────────────────────────────────────────────────
# Fixed public URL for email tracking/unsubscribe links and the WhatsApp webhook URL; leave empty to use the request host.
APP_URL=

# ─── Seed (scripts/db.mjs seed only) ───────────────────────────────────────────
# Login email for the platform admin account the seed creates.
SEED_ADMIN_EMAIL=admin@example.com
# Password for that platform admin account.
SEED_ADMIN_PASSWORD=change-me-admin
# Password for the demo tenant's owner login (owner@bloombrew.example).
SEED_DEMO_PASSWORD=change-me-demo
